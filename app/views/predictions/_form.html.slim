= form_for(@prediction) do |f|
  - if @prediction.errors.any?
    div#error_explanation
      h2 = pluralize(@prediction.errors.count, "error") 
      | prohibited this prediction from being saved:
      ul
      - @prediction.errors.full_messages.each do |message|
        li = message

  fieldset.col-xs-6
    .form-horizontal.mt-3
      
      .form-group.row.mb-3
        = f.label :match_id, class: "control-label col-xs-4 text-end"
        .col-xs-8
          = f.collection_select :match_id, predicable_matches(current_user), :id, ->(match) { "#{match.team1&.name} vs #{match.team2&.name}" }, {}, class: "form-control"
  
      #team1score.form-group.row.mb-3
        = f.label :mainscore1, id: "team1_name", class: "control-label col-xs-4 text-end"
        .col-xs-8
          = f.number_field :mainscore1, class: "form-control"
  
      #team2score.form-group.row.mb-3
        = f.label :mainscore2, id: "team2_name", class: "control-label col-xs-4 text-end"
        .col-xs-8
          = f.number_field :mainscore2, class: "form-control"
  
      #teamselected.form-group.row.mb-3
        label.control-label.col-xs-4.text-end for="teamoption" Choose team
        .col-xs-8
          select id="teamoption" class="form-control"
  
      .form-group.row.mt-4
        .col-xs-8.col-xs-offset-4
          = f.submit 'Submit', class: 'btn btn-primary', data: { disable_with: "Please wait..." }


- team_ids = predicable_matches(current_user).flat_map { |m| [m.team1_id, m.team2_id] }
- team_options = Team.where(id: team_ids).map { |t| { "id" => t.id, "name" => t.name } }
javascript:
  var predicable_matches = #{{predicable_matches(current_user).map{|m| {"id"=>m.id, "team1_id"=>m.team1_id, "team2_id"=>m.team2_id, "knockout"=>m.knockout}}.to_json}};
  var playing_teams = #{{team_options.to_json}};
  $('#prediction_match_id').change(function(){
    var $selected_value=$('#prediction_match_id option:selected').val();
    var $match = predicable_matches.find(x => x.id == $selected_value);
    if (!$match) { return; }
    var $team1_name = playing_teams.find(x => x.id == $match.team1_id).name;
    $('#team1_name').text($team1_name);
    var $team2_name = playing_teams.find(x => x.id == $match.team2_id).name;
    $('#team2_name').text($team2_name);
    $('#teamoption').empty();
    $('#teamoption').append(new Option($team1_name, 1, true, true));
    $('#teamoption').append(new Option($team2_name, 2, false, false));
    if ($match["knockout"] == true) {
      $('#prediction_mainscore1').val(1);
      $('#prediction_mainscore2').val(0);
      $('#team1score').hide();
      $('#team2score').hide();
      $('#teamselected').show();
    }
    else {
      $('#team1score').show();
      $('#team2score').show();
      $('#teamselected').hide();
    }
  });
  $('#teamoption').change(function(){
    var $selected_value=$("#teamoption option:selected").val();
    if ($selected_value == 1) {
      $('#prediction_mainscore1').val(1);
      $('#prediction_mainscore2').val(0);
    }
    else {
      $('#prediction_mainscore1').val(0);
      $('#prediction_mainscore2').val(1);
    }
  });
  $('#prediction_match_id').change();
